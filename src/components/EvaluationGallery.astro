---
import TaskSwitch from "./TaskSwitch.astro";
import { media } from "../lib/media";
import { researchTasks } from "../lib/researchTasks";

const methods = [
  { id: "wan", title: "FlexWAM (Wan)", ours: true },
  { id: "lingbot", title: "FlexWAM (LingBot)", ours: true },
  { id: "pi", title: "π₀.₅", ours: false },
  { id: "fastwam", title: "Fast-WAM", ours: false },
  { id: "openwam", title: "OpenWAM", ours: false },
  { id: "lawam", title: "LaWAM", ours: false },
];
const panels = researchTasks.map((task) => ({
  ...task,
  clips: methods.map((method) => ({
    src: media(`videos/evaluation/${task.id}-${method.id}.mp4`),
    title: method.title,
    detail: `${task.platform} · ${task.trials}`,
    badge: method.ours ? "Ours" : undefined,
    tone: method.ours ? ("ours" as const) : ("neutral" as const),
  })),
}));
---

<TaskSwitch name="Evaluation cases" columns={4} panels={panels} />
